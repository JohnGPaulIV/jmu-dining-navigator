{% extends "appbuilder/base.html" %}
{% block content %}

<div class="container" style="margin-top: 20px;">
  <h2>Dining Hall Capacity Overview</h2>

  <!-- HALL 1 INFO -->
  <div style="font-size: 1.2rem; margin-bottom: 20px;">
    <b>D Hall:</b> {{ live_capacity.current_capacity }} / {{ live_capacity.capacity_limit }}
    <br><small>Updated: {{ live_capacity.timestamp }}</small>
  </div>

  <div id="chart_hall1" style="width: 100%; height: 450px; margin-bottom: 60px;"></div>

  <!-- HALL 2 INFO -->
  <div style="font-size: 1.2rem; margin-bottom: 20px; margin-top: 40px;">
    <b>E Hall:</b> {{ live_capacity2.current_capacity }} / {{ live_capacity2.capacity_limit }}
    <br><small>Updated: {{ live_capacity2.timestamp }}</small>
  </div>

  <div id="chart_hall2" style="width: 100%; height: 450px;"></div>
</div>

<script src="https://www.gstatic.com/charts/loader.js"></script>

<script>
google.charts.load('current', {packages:['corechart']});
google.charts.setOnLoadCallback(drawCharts);

// convert "HH:MM" → Date()
function toTime(t) {
    let [h, m] = t.split(":").map(Number);
    return new Date(2025, 0, 1, h, m);
}

function drawCharts() {
    drawHall1();
    drawHall2();
}

// ------------------------------
// HALL 1 GRAPH
// ------------------------------
function drawHall1() {
    var data = new google.visualization.DataTable();
    data.addColumn('datetime', 'Time');
    data.addColumn('number', 'Average Capacity');

    {% for row in avg_data %}
        data.addRow([
            toTime('{{ row.time_block }}'),
            {{ row.avg_capacity }}
        ]);
    {% endfor %}

    var options = {
        title: "D Hall – Average Capacity (8am–8pm)",
        hAxis: { title: "Time of Day", format: "HH:mm" },
        vAxis: {
            title: "Capacity",
            viewWindow: { min: 0, max: {{ live_capacity.capacity_limit }} }
        },
        legend: { position: "none" },
        connectSteps: true,
        areaOpacity: 0.3,
        colors: ["#450084"]  // JMU Purple
    };

    var chart = new google.visualization.SteppedAreaChart(
        document.getElementById("chart_hall1")
    );
    chart.draw(data, options);
}


// ------------------------------
// HALL 2 GRAPH
// ------------------------------
function drawHall2() {
    var data = new google.visualization.DataTable();
    data.addColumn('datetime', 'Time');
    data.addColumn('number', 'Average Capacity');

    {% for row in avg_data2 %}
        data.addRow([
            toTime('{{ row.time_block }}'),
            {{ row.avg_capacity }}
        ]);
    {% endfor %}

    var options = {
        title: "E Hall – Average Capacity (8am–8pm)",
        hAxis: { title: "Time of Day", format: "HH:mm" },
        vAxis: {
            title: "Capacity",
            viewWindow: { min: 0, max: {{ live_capacity2.capacity_limit }} }
        },
        legend: { position: "none" },
        connectSteps: true,
        areaOpacity: 0.3,
        colors: ["#CBB677"]  // JMU Gold
    };

    var chart = new google.visualization.SteppedAreaChart(
        document.getElementById("chart_hall2")
    );
    chart.draw(data, options);
}

</script>

{% endblock %}
