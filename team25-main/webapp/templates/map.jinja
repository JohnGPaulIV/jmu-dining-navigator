{% extends "appbuilder/base.html" %}

{% block head_css %}
  {{ super() }}
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <style>
    .map-fullwidth {
      width: 100vw;
      max-width: none;
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
      padding: 0;
    }
    #map {
      width: 100%;
      height: 92vh;
      min-height: 820px;
      border-radius: 0;
      box-shadow: 0 8px 22px rgba(0,0,0,0.12);
    }
    
    /* ========== POPUP STYLING ========== */
    .leaflet-popup-content {
      font-size: 18px !important;
      line-height: 1.6 !important;
      color: var(--jmu-purple, #450084) !important;
      font-weight: 600 !important;
      min-width: 200px !important;
    }
    
    .leaflet-popup-content a {
      color: var(--jmu-purple, #450084) !important;
      font-size: 16px !important;
      text-decoration: none !important;
      display: block !important;
      padding: 4px 0 !important;
    }
    
    .leaflet-popup-content a:hover {
      color: var(--jmu-gold, #CBB677) !important;
      text-decoration: underline !important;
    }
    
    .leaflet-popup-content u {
      font-size: 20px !important;
      color: var(--jmu-purple, #450084) !important;
      font-weight: 700 !important;
    }
    
    .leaflet-popup-content br {
      line-height: 2 !important;
    }
  </style>
{% endblock %}

{% block content %}
  <div class="container-fluid map-fullwidth" style="padding: 0;">
    <div id="map" aria-label="Campus map"></div>
  </div>
{% endblock %}

{% block tail_js %}
  {{ super() }}
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script>
    (function(){
      var map = L.map('map', {
        center: [38.43530510720038, -78.8649895794139],
        zoom: 17,
        maxZoom: 18,
        minZoom: 14,
        maxBounds: [[38.456902990612214, -78.89402676202633], [38.39574371961555, -78.8187446627368]],
        maxBoundsViscosity: 1
      });

      // Satellite basemap (ESRI)
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles © ESRI, Earthstar Geographics'
      }).addTo(map);

      var bigIcon = L.icon({
        iconUrl: 'https://cdn-icons-png.freepik.com/512/5860/5860579.png',
        shadowUrl: 'https://unpkg.com/leaflet/dist/images/marker-shadow.png',
        iconSize: [70, 70],
        iconAnchor: [30, 62],
        popupAnchor: [1, -60]
      });

      /* Main Campus Dining Hall */
      L.marker([38.43734195625987, -78.87217840075753], { icon: bigIcon }).addTo(map).bindPopup(`
        <u>D-Hall</u><br/>
        <a href="/place/d-hall">Main Campus Dining Hall</a><br/>
        <a href="/place/chick-fil-a-in-d-hall">Chick-fil-A</a><br/>
        <a href="/place/jmu-java-city-d-hall">Java City</a><br/>
        <a href="/place/market-64">Market 64</a><br/>
        <a href="/place/dukes-scoops">Dukes Scoops & Cheesesteaks</a><br/>
        <a href="/place/freshens-fresh-food-studio-in-d-hall">Freshëns Fresh Food Studio</a><br/>
        <a href="/place/steak-n-shake">Steak 'n Shake</a>
      `);

      /* Dukes Dining */
      L.marker([38.43850994377073, -78.87081532349089], { icon: bigIcon }).addTo(map).bindPopup(`
        <u>Dukes Dining</u><br/>
        <a href="/place/blue-ridge-innovations">Blue Ridge Innovations</a><br/>
        <a href="/place/heirloom-pizza-in-dukes-dining">Heirloom Pizza</a><br/>
        <a href="/place/tacodillo">Tacodillo</a><br/>
        <a href="/place/panda-express">Panda Express</a><br/>
        <a href="/place/panera-in-dukes-dining">Panera</a><br/>
        <a href="/place/the-den-in-dukes-dining">The Den by Denny's</a>
      `);

      /* East Campus */
      L.marker([38.43130508959355, -78.86129858400058], { icon: bigIcon }).addTo(map).bindPopup(`
        <a href="/place/e-hall">East Campus Dining Hall</a><br/>
        <a href="/place/jemmy-s-corner-market-and-pod">Jemmy’s Corner Market and POD</a>
      `);

      /* Festival */
      L.marker([38.43285577972582, -78.85970540128767], { icon: bigIcon }).addTo(map).bindPopup(`
        <u>Festival</u><br/>
        <a href="/place/burgers-fries">Burgers+Fries</a><br/>
        <a href="/place/chick-fil-a-at-festival">Chick-fil-A</a><br/>
        <a href="/place/ignite">Ignite Pizza and Pasta</a><br/>
        <a href="/place/madison-press">Madison Press Deli</a>
      `);

      /* Other locations */
      L.marker([38.43352443243899, -78.86744683381708], { icon: bigIcon }).addTo(map).bindPopup(`<u>UREC</u><br/><a href="/place/freshens-urec">Freshëns Fresh Food Studio</a>`);
      L.marker([38.4448853458119, -78.8785843514442], { icon: bigIcon }).addTo(map).bindPopup(`<u>Memorial Hall</u><br/><a href="/place/corner-bistro">Corner Bistro</a>`);
      L.marker([38.43414643700397, -78.85837937324493], { icon: bigIcon }).addTo(map).bindPopup(`<u>Rose Library</u><br/><a href="/place/starbucks-at-rose-library">Starbucks</a>`);
      L.marker([38.4379814942908, -78.87010591736443], { icon: bigIcon }).addTo(map).bindPopup(`<u>Taylor Down Under</u><br/><a href="/place/merge-coffee">Merge Coffee</a>`);
      L.marker([38.442628154832846, -78.87589301292222], { icon: bigIcon }).addTo(map).bindPopup(`<u>Grace Street</u><br/><a href="/place/subway">Subway</a>`);
      L.marker([38.43060226235298, -78.8591190675899], { icon: bigIcon }).addTo(map).bindPopup(`<u>Atlantic Union Bank Center</u><br/><a href="/place/tenders-love-chicken">Tenders. Love. Chicken.</a>`);
      L.marker([38.44011450015448, -78.87144034425067], { icon: bigIcon }).addTo(map).bindPopup(`<u>Student Success Center</u><br/><a href="/place/bistro-1908">Bistro 1908</a><br/><a href="/place/dunkin-donuts-in-ssc">Dunkin'</a>`);
      L.marker([38.43348670823243, -78.87251673763106], { icon: bigIcon }).addTo(map).bindPopup(`<u>College of Business</u><br/><a href="/place/lakeside-cafe">Lakeside Cafe</a>`);
      L.marker([38.437495169824615, -78.87322011765735], { icon: bigIcon }).addTo(map).bindPopup(`<a href="/place/starbucks-truck">Starbucks Truck</a>`);
      L.marker([38.4371416049146, -78.86974082124243], { icon: bigIcon }).addTo(map).bindPopup(`<a href="/place/mr-chips">Mr. Chips</a>`);
      L.marker([38.44011083797087, -78.87653246064733], { icon: bigIcon }).addTo(map).bindPopup(`<a href="/place/pod-in-forbes-center">POD in Forbes Center</a>`);
      L.marker([38.43075332825976, -78.8663331233613], { icon: bigIcon }).addTo(map).bindPopup(`<a href="/place/pod-in-jennings-hall">POD in Jennings Hall</a>`);
      L.marker([38.43410205838021, -78.86216973371612], { icon: bigIcon }).addTo(map).bindPopup(`<a href="/place/pod-in-king-hall">POD in King Hall</a>`);
    })();
  </script>
{% endblock %}